  "data": [
    {
      "name": "csv_head",
      "description": "Show first rows of a CSV.",
      "command": "head -n 10 {path}"
    },
    {
      "name": "csv_columns",
      "description": "Show column names of a CSV.",
      "command": "head -n 1 {path} | tr ',' '\\n' | cat -n"
    },
    {
      "name": "csv_row_count",
      "description": "Count rows in a CSV.",
      "command": "wc -l < {path}"
    },
    {
      "name": "json_pretty",
      "description": "Pretty-print a JSON file.",
      "command": "python -m json.tool {path}"
    },
    {
      "name": "json_keys",
      "description": "Extract top-level keys from JSON.",
      "command": "python -c \"import json,sys; d=json.load(open('{path}')); [print(k) for k in (d if isinstance(d,dict) else d[0])]\""
    },
    {
      "name": "sqlite_tables",
      "description": "List tables in a SQLite DB.",
      "command": "sqlite3 {path} '.tables'"
    },
    {
      "name": "sqlite_schema",
      "description": "Show schema of a SQLite DB.",
      "command": "sqlite3 {path} '.schema'"
    }
  ],
  "media": [
    {
      "name": "ffprobe_info",
      "description": "Show media file metadata.",
      "command": "ffprobe -v quiet -print_format json -show_format -show_streams {path}"
    },
    {
      "name": "img_dimensions",
      "description": "Get image dimensions.",
      "command": "python -c \"from PIL import Image; img=Image.open('{path}'); print(f'{img.size[0]}x{img.size[1]} {img.mode} {img.format}')\""
    },
    {
      "name": "mediainfo_summary",
      "description": "Show media info summary.",
      "command": "mediainfo {path} 2>/dev/null || ffprobe -v quiet -show_entries format=duration,size,bit_rate -of default=noprint_wrappers=1 {path}"
    },
    {
      "name": "youtube_dl_info",
      "description": "Get YouTube video info.",
      "command": "yt-dlp --print title --print duration --print view_count {url} 2>/dev/null || echo 'yt-dlp not available'"
    }
  ],
