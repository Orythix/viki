# https://editorconfig.org
# Cross-platform consistency for contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,html,css,scss,md}]
indent_size = 2

[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
