{
  "info": {
    "name": "Security Lab (local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "apiKey", "value": "dev-lab-change-me" },
    { "key": "role", "value": "lab_admin" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Metrics (auth)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Lab-API-Key", "value": "{{apiKey}}" },
          { "key": "X-Lab-Role", "value": "{{role}}" }
        ],
        "url": "{{baseUrl}}/api/v1/metrics"
      }
    }
  ]
}
