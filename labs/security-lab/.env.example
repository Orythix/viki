# Copy to .env and adjust (do not commit .env)
LAB_API_KEY=change-me-to-a-long-random-secret
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
DATABASE_URL=sqlite:///./data/lab_audit.db
# Optional: PostgreSQL audit log
# DATABASE_URL=postgresql://lab:lab@127.0.0.1:5432/lab
RATE_LIMIT_PER_MINUTE=60
TOOL_ALLOWLIST=python,echo,whoami
